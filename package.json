{
  "name": "sleep-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": "24.x" },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3001",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3001",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/migrate.ts"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@clerk/nextjs": "7.9.20",
    "@vercel/functions": "^3.0.0",
    "pg": "^8.16.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "tsx": "^4.20.6",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/pg": "^8.15.5",
    "@electric-sql/pglite": "^0.3.14"
  }
}
